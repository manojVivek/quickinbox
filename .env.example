# Deployment configuration (local / CI only — not a Worker runtime secret).
# Copy the UUID from Cloudflare D1. Bun loads this from the gitignored .env file.
# In Workers Builds, add D1_DATABASE_ID under Settings → Build → Variables and secrets.
D1_DATABASE_ID=

# General Translation CLI (local / CI only — not Worker secrets).
# Create a project at https://generaltranslation.com/dashboard
# then run: bun run translate
# GitHub Actions: Settings → Secrets → Actions → GT_API_KEY and GT_PROJECT_ID
GT_API_KEY=
GT_PROJECT_ID=
